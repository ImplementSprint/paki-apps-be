{
  "serviceId": "paki-apps",
  "name": "Paki Apps Backend",
  "serviceType": "tribe",
  "baseUrl": "http://localhost:3001",
  "requiredScopes": ["tribe:paki-apps:read", "tribe:paki-apps:write"],
  "exposes": ["/api/v1/health", "/api/v1/location/resolve"],
  "consumes": ["payment", "email"],
  "healthCheck": "/api/v1/health",
  "version": "1.0.0",
  "description": "Paki Apps Backend service built as a NestJS monorepo microservices backend"
}
